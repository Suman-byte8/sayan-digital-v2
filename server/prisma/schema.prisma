generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  // Multiple product photos — images[0] is treated as the cover/thumbnail
  // everywhere a single image is needed (table, cards, JSON-LD).
  images      String[] @default([])
  // Wholesale-style minimum order quantity (e.g. lanyards, bulk stationery).
  // Optional — most products have no minimum.
  minOrderQty Int?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}
