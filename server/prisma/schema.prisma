generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  PRINTING
  STATIONERY
}

// The managed list of category names offered when adding/editing a
// product — populated by picking a match from the Google Product
// Taxonomy search or by adding a custom one (see src/lib/taxonomy.js and
// routes/categories.routes.js). Product.category stays a plain string
// (not a foreign key) so existing/imported product rows never break;
// this table is a curated suggestion list layered on top of that.
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  // "taxonomy" (picked from the Google Product Taxonomy search) or
  // "custom" (typed by hand, no match found).
  source    String   @default("custom")
  createdAt DateTime @default(now())

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  category    String?
  // Distinguishes the two storefront catalogs (client's /products vs
  // /stationery) — everything lives in one table, filtered by this.
  type        ProductType @default(PRINTING)
  // Ordering unit shown next to price, e.g. "pc", "set", "100 pcs".
  unit        String?
  // Short merchandising label, e.g. "Customizable", "220 GSM".
  badge       String?
  // Multiple product photos — images[0] is treated as the cover/thumbnail
  // everywhere a single image is needed (table, cards, JSON-LD).
  images      String[]    @default([])
  // Wholesale-style minimum order quantity (e.g. lanyards, bulk stationery).
  // Optional — most products have no minimum.
  minOrderQty Int?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@map("products")
}

// ---------------------------------------------------------------------
// Customer accounts (client/ storefront) — separate from the admin panel,
// which has no login of its own yet and talks to this API directly.
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  // Never store or log the plain password — only its bcrypt hash.
  passwordHash String
  phone        String?
  businessName String?
  gstin        String?
  avatarUrl    String?
  loyaltyPoints Int     @default(0)
  // "Member" badge on the customer's profile — deliberately admin-set only,
  // not auto-derived from loyaltyPoints/order history. No customer-facing
  // way to change this.
  isMember     Boolean @default(false)

  // Notification preferences — simple per-user booleans rather than a
  // separate table, since it's always exactly one row per user.
  notifyOrderUpdatesWhatsapp Boolean @default(true)
  notifyDeliverySms          Boolean @default(true)
  notifyDesignProofAlerts    Boolean @default(true)
  notifyPromotionalEmail     Boolean @default(false)
  notifyFestiveDiscounts     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  addresses      Address[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]
  orders         Order[]
  paymentMethods PaymentMethod[]
  proofs         Proof[]

  @@map("users")
}

// One row per active refresh token, so logout/expiry are real (server-can
// revoke) rather than relying purely on a stateless JWT's own expiry.
// The refresh token itself is never stored — only its SHA-256 hash, same
// principle as password hashing (a stolen DB row shouldn't hand out a
// usable token).
model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@map("sessions")
}

model Address {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String
  recipientName     String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("addresses")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// A user's shopping cart is just "every CartItem row with their userId" -
// same one-table-per-user pattern as WishlistItem, no separate Cart header
// row needed since there's no concept of multiple carts per user. Doesn't
// reserve/decrement Product.stock - that only happens at real order
// placement (see Order's own comment - no checkout flow exists yet).
model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

// Real checkout flow (POST /api/orders, see orders.controller.js): creates
// an Order + snapshotted OrderItems from the user's current CartItems, then
// clears the cart. Payment is Cash on Delivery only for now — Razorpay
// isn't integrated yet, so paymentMethod is validated server-side to only
// ever be "COD" until that lands (see createOrderSchema).
model Order {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)
  // Shipping address is snapshotted onto the order itself (same reasoning
  // as OrderItem snapshotting product data below) rather than a live FK to
  // Address — editing/deleting a saved address later must never change
  // what a past order actually shipped to.
  shippingName         String
  shippingPhone        String
  shippingAddressLine1 String
  shippingAddressLine2 String?
  shippingCity         String
  shippingState        String
  shippingPincode      String
  shippingCarrier String?
  trackingNumber String?
  paymentMethod  String?
  isPaid         Boolean     @default(false)
  estimatedDelivery DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items OrderItem[]

  @@map("orders")
}

// A snapshot of the product at order time (name/price/image) — standard
// e-commerce practice, since the live Product row can change or be
// deleted later but a past order's receipt shouldn't.
model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  customization String?
  image         String?
  quantity      Int
  price         Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

// User-entered payment references for their own bookkeeping only — NOT
// connected to a real payment gateway/processor. Deliberately has no
// field for a full card number, CVV, or expiry — only masked/display
// text the user types themselves (e.g. "•••• •••• •••• 4892"), the same
// way this already worked in the UI mockup this replaces. Wiring up real
// payment processing later means integrating a gateway (Razorpay/Stripe)
// and its own tokenization — never storing raw card data here.
model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  detail    String
  isPrimary Boolean  @default(false)
  badge     String?
  createdAt DateTime @default(now())

  @@map("payment_methods")
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// Design-proof review before production. Schema + a real list endpoint
// exist, but there's no admin-side workflow to create/attach a proof to
// an order yet (see server/README.md) — every user's proof list is
// genuinely empty until that's built, same caveat as Order above.
model Proof {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  product       String
  orderRef      String?
  designer      String?
  status        ProofStatus @default(PENDING)
  notes         String?
  dimensions    String?
  colorProfile  String?
  previewUrl    String?
  submittedAt   DateTime    @default(now())
  approvedAt    DateTime?

  @@map("proofs")
}
