# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection string.
# For now: local PostgreSQL via pgAdmin (database "sayan_digital").
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/sayan_digital"
# Later (production): swap in a Supabase project's connection string -
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# The app code is unaware of the difference - it's just Postgres either way.

# Comma-separated list of origins allowed to call this API (the client and
# admin Next.js apps).
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# Optional - only needed for POST /api/uploads/image (product image
# uploads). See "Image uploads (Google Drive)" in server/README.md for how
# to create these. Without them the rest of the API works fine.
# From an OAuth Client ID (type "Desktop app") in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set the two above first, then run `npm run drive:auth` to get this one -
# it prints the exact line to paste here.
GOOGLE_OAUTH_REFRESH_TOKEN=
# The Drive folder's id (from its URL: drive.google.com/drive/folders/<THIS>).
GOOGLE_DRIVE_FOLDER_ID=
