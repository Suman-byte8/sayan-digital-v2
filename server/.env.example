# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection string. In production this is your Supabase project's
# connection string: Supabase Dashboard -> Project Settings -> Database ->
# Connection string (use the "Transaction" pooler URI for serverless/most
# hosts, or the direct connection URI for long-lived servers).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/sayan_digital"

# Comma-separated list of origins allowed to call this API (the client and
# admin Next.js apps).
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
